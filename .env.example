# ---- Banco ----
GAMEDEALS_DB=./deals.db

# ---- IsThereAnyDeal (jogos de PC) ----
# Chave gratuita: https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# ---- Mercado Livre ----
# 1. Crie um app em https://developers.mercadolivre.com.br/devcenter
# 2. Em 'Autenticacao e seguranca' > 'Redirect URI', cadastre EXATAMENTE:
#       https://localhost:8788/callback     (o ML exige https)
# 3. Preencha os dois abaixo e rode: uv run python scripts/ml_auth.py
#    (o ML exige token em tudo desde 2024 — nao ha acesso anonimo)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://localhost:8788/callback
# Preenchido automaticamente pelo ml_auth.py; rotaciona a cada renovacao.
ML_REFRESH_TOKEN=

# ---- Amazon Brasil (Product Advertising API v5) ----
# Exige conta de Afiliados aprovada COM vendas qualificadas.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# ---- Shopee Brasil (Affiliate Open API) ----
# https://affiliate.shopee.com.br -> Open API
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# ---- Notas da critica e popularidade (RAWG) ----
# Chave gratuita (so e-mail): https://rawg.io/apidocs
# Traz metacritic, nota de usuarios, contagens e capa. Sem ela, discover_top e
# enrich_ratings ficam inertes; o resto do sistema roda igual.
RAWG_API_KEY=

# ---- Alertas ----
# Topico ntfy.sh (push no celular, sem cadastro). Ex: gamedeals-luiz-8f2a
NTFY_TOPIC=
# Notificacao nativa do macOS (requer: brew install terminal-notifier)
MACOS_NOTIFY=1

# ---- Regiao ----
COUNTRY=BR
CURRENCY=BRL
